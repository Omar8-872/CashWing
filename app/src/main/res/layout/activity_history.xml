<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pay_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        android:background="@drawable/bg_header">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/history"
            android:padding="12dp"
            android:src="@drawable/ic_history" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/transaction_history"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/editSearch"
        style="@style/PayInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:drawableStart="@drawable/ic_search"
        android:hint="@string/hint_search"
        android:inputType="text"
        android:maxLines="1" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:scrollbars="none">

        <RadioGroup
            android:id="@+id/radioFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:buttonTint="@color/pay_primary"
                    android:text="@string/filter_all"
                    android:textColor="@color/pay_dark"
                    android:textSize="15sp"
                    android:checked="true" />
                <RadioButton
                    android:id="@+id/radioSent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:buttonTint="@color/pay_primary"
                    android:text="@string/filter_sent"
                    android:textColor="@color/pay_dark"
                    android:textSize="15sp" />
                <RadioButton
                    android:id="@+id/radioReceived"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:buttonTint="@color/pay_primary"
                    android:text="@string/filter_received"
                    android:textColor="@color/pay_dark"
                    android:textSize="15sp" />
                <RadioButton
                    android:id="@+id/radioRejected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:buttonTint="@color/pay_primary"
                    android:text="@string/filter_rejected"
                    android:textColor="@color/pay_dark"
                    android:textSize="15sp" />
        </RadioGroup>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/textHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:text="@string/history"
            android:textColor="@color/black"
            android:textSize="16sp" />
    </ScrollView>

    <Button
        android:id="@+id/btnHome"
        style="@style/PayButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:drawableStart="@drawable/ic_home"
        android:text="@string/back_home" />
</LinearLayout>
