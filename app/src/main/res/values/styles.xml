<resources>
    <!-- Modern rounded button with an icon on the left -->
    <style name="PayButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">@color/white</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="PayButton.Dark">
        <item name="android:background">@drawable/btn_dark</item>
    </style>

    <style name="PayButton.Red">
        <item name="android:background">@drawable/btn_red</item>
    </style>

    <style name="PayButton.Gold">
        <item name="android:background">@drawable/btn_gold</item>
    </style>

    <style name="PayButton.Outline">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/pay_primary</item>
        <item name="android:drawableTint">@color/pay_primary</item>
    </style>

    <!-- White rounded input with an icon on the left -->
    <style name="PayInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/pay_primary</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/pay_gray</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- small quick-amount button -->
    <style name="PayChip" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/pay_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
</resources>
