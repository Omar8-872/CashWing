<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/pay_dark"
                android:startColor="@color/pay_primary" />
            <corners
                android:bottomLeftRadius="36dp"
                android:bottomRightRadius="36dp" />
        </shape>
    </item>
    <!-- flying money pattern in the corner of every header -->
    <item
        android:width="260dp"
        android:height="130dp"
        android:drawable="@drawable/ic_header_money"
        android:gravity="end|top" />
</layer-list>
